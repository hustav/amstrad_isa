# --- KiCad ---------------------------------------------------------------
# Per-user layout / view state (do not commit)
*.kicad_prl

# Backup files KiCad sprinkles next to the project
*.bak
*-bak/
*-backups/
*.kicad_pcb-bak
*.kicad_sch-bak
*.auto_saved_files*
_autosave-*
*.lck

# KiCad editor history folder
.history/

# --- Fabrication outputs --------------------------------------------------
# KiCad's plot dialog drops loose gerbers here — ignore by default.
/gerbers-generated/
**/Gerber/
*.gbr
*.drl
*.pos
*.rpt

# ...BUT track the curated /fab/ release drop. That folder holds the
# gerbers that match the committed PCB and is what people without KiCad
# should use to order boards.
!/fab/
!/fab/**

# --- Python --------------------------------------------------------------
__pycache__/
*.pyc

# --- OS / editor cruft ---------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
